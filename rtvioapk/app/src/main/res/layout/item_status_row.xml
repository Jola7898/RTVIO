<?xml version="1.0" encoding="utf-8"?>
<!-- One label/value line in the status panel. Included several times from
     activity_main, so view binding exposes each copy under its include id. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/rowLabel"
        style="@style/StatusLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        tools:text="Bandwidth" />

    <TextView
        android:id="@+id/rowValue"
        style="@style/StatusValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        tools:text="3.2 Mbps" />
</LinearLayout>
